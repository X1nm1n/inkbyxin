# Copia questo file in .env: i valori seguenti sono facoltativi.
# Server locale (per il deploy usare variabili ambiente del provider).
SITE_HOST=127.0.0.1
SITE_PORT=8000

# Notifiche email (se vuote, i contatti vengono comunque salvati in SQLite).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
SMTP_USE_TLS=true

# Separazione dati dal codice: path assoluto o relativo alla cartella del progetto.
DATABASE_PATH=data/contacts.db
